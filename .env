# DailyBloom Frontend Environment Variables

# Google Analytics 4 Measurement ID (Optional - add your GA4 ID here)
# VITE_GA_MEASUREMENT_ID=G-XXXXXXXXXX

# Sentry DSN (Optional - add your Sentry DSN here)
# VITE_SENTRY_DSN=https://your-sentry-dsn@sentry.io/project-id

# Enable Sentry in development (Optional - set to 'true' to test Sentry in development)
# VITE_SENTRY_ENABLED=false